+// 每帧从播放器取新画面，塞给 Layer1 / Layer2。
+// 原来这段逻辑在 WndProc 里（win32 的消息泵），SDL 这边改成连续事件回调。
+//---------------------------------------------------------------------------
+void TJS_INTF_METHOD tTJSNI_VideoOverlay::OnContinuousCallback(tjs_uint64 tick)
+{
+	if(!VideoOverlay || !Bitmap[0]) return;
+
+	BYTE *front = NULL;
+	VideoOverlay->GetFrontBuffer(&front);
+	if(!front) return;   // 还没有新帧
+
+	class tTVPBaseBitmap *img = (front == BmpBits[0]) ? Bitmap[0] : Bitmap[1];
+
+	if(Layer1)
+	{
+		Layer1->AssignMainImage(img);
+		Layer1->Update();
+	}
+	if(Layer2)
+	{
+		Layer2->AssignMainImage(img);
+		Layer2->Update();
+	}
+}
