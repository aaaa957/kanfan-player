 //---------------------------------------------------------------------------
+// 内建插件名单
+//---------------------------------------------------------------------------
+// 这些插件的类在引擎启动时（ncbAutoRegister::AllRegist）就已经注册到全局对象上了，
+// 但脚本里的 Plugins.link("xxx.dll") 仍会走 dlopen 找 xxx.so，找不到就抛
+// TVPCannotLinkPlugin，游戏多半会在这里直接崩。
+// 所以这里拦一道：名单内的模块名直接视为「链接成功」。
+// 名字必须与插件源码里的 NCB_MODULE_NAME 一致（比较时不区分大小写）。
+static const tjs_char * const TVPBuiltinPluginNames[] = {
+	TJS_W("csvParser.dll"),
+	TJS_W("saveStruct.dll"),
+	TJS_W("getSample.dll"),
+	TJS_W("getabout.dll"),
+	TJS_W("fftgraph.dll"),
+	TJS_W("win32dialog.dll"),
+	TJS_W("wutcwf.dll"),
+	TJS_W("varfile.dll"),
+	TJS_W("fstat.dll"),
+	TJS_W("json.dll"),
+	TJS_W("extrans.dll"),
+	TJS_W("wuvorbis.dll"),
+	TJS_W("krglhwebp.dll"),
+	TJS_W("krmovie.dll"),      // 引擎内建（external/krmovie，ffmpeg 解码）
+	NULL
+};
+
+static tjs_char TVPLowerAscii(tjs_char c)
+{
+	return (c >= TJS_W('A') && c <= TJS_W('Z')) ? (tjs_char)(c + 32) : c;
+}
+
+static bool TVPNameEqualsNoCase(const tjs_char * a, const tjs_char * b)
+{
+	if(!a || !b) return false;
+	while(*a && *b)
+	{
+		if(TVPLowerAscii(*a) != TVPLowerAscii(*b)) return false;
+		a ++, b ++;
+	}
+	return *a == 0 && *b == 0;
+}
+
+static bool TVPIsBuiltinPlugin(const ttstr & name)
+{
+	// 脚本里可能写成 "plugin/xxx.dll"，只取文件名比较
+	ttstr base = TVPExtractStorageName(name);
+	const tjs_char * p = base.c_str();
+	for(int i = 0; TVPBuiltinPluginNames[i]; i ++)
+	{
+		if(TVPNameEqualsNoCase(p, TVPBuiltinPluginNames[i])) return true;
+	}
+	return false;
+}
+//---------------------------------------------------------------------------
 static bool TVPPluginLoading = false;
 void TVPLoadPlugin(const ttstr & name)
 {
 #ifdef KRKRSDL2_ENABLE_PLUGINS
+	// 内建插件：类已经注册好了，不需要（也不能）dlopen
+	if(TVPIsBuiltinPlugin(name)) return;
+
 	// load plugin
 	if(TVPPluginLoading)
 		TVPThrowExceptionMessage(TVPCannnotLinkPluginWhilePluginLinking);
